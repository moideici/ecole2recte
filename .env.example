# Copie ce fichier en `.env` — jamais versionné — et remplis-le.

# Clé de scellement du couple de confiance de la question de sécurité.
# Obligatoire en production : sans elle, l'application refuse de sceller.
# Génère-la avec : openssl rand -base64 48
SESSION_SECRET=

# Version d'API déclarée à ÉcoleDirecte.
# Elle périme sans préavis : le jour où toutes les requêtes échouent avec le code 517,
# c'est ici qu'on la corrige, sans redéployer.
ED_API_VERSION=4.101.4

# Fuseau de l'établissement. Le serveur peut tourner ailleurs ; l'élève, non.
ED_TIMEZONE=Europe/Paris

# Démonstration : `1` ajoute sur la page de connexion deux accès — espace élève et espace
# professeur — sur des données entièrement inventées. Aucune requête ne part vers ÉcoleDirecte
# depuis une session de démonstration.
ED_DEMO=0

# Police d'écriture : deny (défaut) | dry-run | allow
# `dry-run` construit et trace les requêtes sans rien envoyer : c'est le mode de relecture
# avant le premier envoi réel.
ED_WRITE_POLICY=deny

# Fonctions d'écriture ouvertes, séparées par des virgules, ou `all`.
# N'ouvre une fonction qu'après avoir vu son aller-retour réel passer (pnpm smoke).
#   homework-done, homework-comment, cloud-folder, cloud-rename, cloud-delete
ED_WRITE_FEATURES=

# Base de l'API. À ne changer que pour viser un serveur factice pendant les essais.
# ED_API_BASE=http://127.0.0.1:8787/v3

# ————————————————————————————————————————————————————————————————————————————
# Pour `pnpm verifier` et `pnpm smoke` uniquement : les identifiants d'un vrai compte.
#
# Ces deux scripts se lancent à la main et jamais en intégration continue. Le fichier `.env`
# n'est pas versionné — c'est la première chose que `.gitignore` protège — mais un mot de
# passe posé sur un disque reste un mot de passe : le laisser vide et le taper au clavier,
# ce que les deux scripts proposent, est plus sûr.
#
# La date de naissance sert à répondre à la question de sécurité. Il vaut mieux la taper au
# clavier elle aussi : elle n'a pas à traîner dans un fichier.
#
# id=
# mdp=
# naissance=AAAA-MM-JJ
